# CI/CD settings, read by .github/workflows/ci-config.yaml.
# Committed, so every project created from this skeleton gets the same defaults.
# A repository variable with the same name (Settings -> Secrets and variables
# -> Actions -> Variables) overrides a value here.
# Keep comments on their own line.

# Docker build check on PRs, plus image build/push to SWR and deploy on push
# to main. Only "true" (any case) turns it on; unset or anything else is off.
DOCKER_ENABLED=false

# --- Deployment target (used when DOCKER_ENABLED=true; see deploy/README.md) ---
# SWR organization (namespace) the image is pushed to. Deploys refuse to run
# while this is still the placeholder.
SWR_ORG=your-org
# Image repository name inside that organization.
IMAGE_NAME=pokemon-ocr-be
# Directory on the server holding docker-compose.yml, deploy.sh, .env, api.env.
DEPLOY_DIR=/opt/app/api
