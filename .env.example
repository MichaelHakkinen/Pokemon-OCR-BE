# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/db_name"

# Server Configuration
APP_PORT=3003
APP_URL="http://localhost:3003"
APP_ENV="development"
APP_TIMEZONE="Asia/Jakarta"

# Reverse-proxy hops in front of the app (1 = behind a single nginx), or false
# when clients connect directly. Decides the client IP used for rate limiting
# and logs — leaving it false behind nginx makes every client share nginx's IP.
TRUST_PROXY=false

# JWT Configuration
# At least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET_KEY="change-me-to-a-random-string-of-32-chars-or-more"
JWT_EXPIRATION_TIME="30m"
REFRESH_TOKEN_EXPIRATION_TIME="3d"

# Logging Configuration
# On/off settings in this file: only "true" (any case: true, TRUE, True) turns
# them on; anything else (false, 1, yes, empty) means off.
# Keep comments on their own line — `docker run --env-file` would treat an
# inline "# ..." as part of the value.
# SYSTEM_LOG (on/off): write admin actions to the logs table
SYSTEM_LOG=true
# ERROR_LOG (on/off): write 5xx errors to the error_logs table
ERROR_LOG=true

# Other Configuration
# Optional: 32-byte hex key for encryptPayload/decryptPayload (AES-256-GCM).
# Generate with: openssl rand -hex 32
ENCRYPT_SECRET_KEY=

# Phone number normalisation — country calling code without leading +
# Used by HelperService.normalizePhoneNumber() as the default country code.
# Override per-call for multi-country support.
# Examples: 62 (Indonesia), 1 (US/CA), 44 (UK), 65 (Singapore)
APP_PHONE_COUNTRY_CODE=62

# Email Configuration
# port: 587, // Typically 587 for STARTTLS, 465 for SSL
# secure: false, // true for 465, false for other ports
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
SMTP_FROM=your-email@example.com
SMTP_FROM_NAME="Your Name"
# SMTP_SECURE (on/off): true for port 465 (SSL), false for 587 (STARTTLS)
SMTP_SECURE=false

# Mail Service (Marley — office HTTP mail relay, used by MailRelayService)
# On when unset or empty; any value but true is off. Set false for projects without Marley: the app then
# starts without MAIL_SERVICE_URL / MAIL_VAULT_TOKEN and skips every send.
MAIL_SERVICE_ENABLED=true
# While on, both are required when APP_ENV is staging or production. Use
# Marley's real address: inside the Docker image, localhost:4000 is this app.
MAIL_SERVICE_URL=http://localhost:4000
MAIL_VAULT_TOKEN=your-mail-vault-bearer-token

# OTP Configuration
# Number of digits in password-reset OTPs (4–10)
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=5
OTP_RESEND_DELAY_SECONDS=60
# Wrong guesses allowed before an OTP is invalidated
OTP_MAX_ATTEMPTS=5

# Storage Configuration (local, s3, obs)
DISK_STORAGE=local

# AWS S3 Configuration (required when DISK_STORAGE=s3)
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET_NAME=your-bucket-name

# Huawei OBS Configuration (required when DISK_STORAGE=obs)
OBS_ACCESS_KEY_ID=your-obs-access-key-id
OBS_SECRET_ACCESS_KEY=your-obs-secret-access-key
OBS_ENDPOINT=obs.ap-southeast-1.myhuaweicloud.com
OBS_BUCKET_NAME=your-bucket-name
OBS_DOMAIN_NAME=your-bucket-name.obs.ap-southeast-1.myhuaweicloud.com
# Expiry in seconds for presigned URLs (default: 300 = 5 minutes)
OBS_SIGNED_URL_EXPIRES=300

# CDN Token Authentication (optional — for Huawei CDN token-auth protected assets)
# CDN_TOKEN_AUTH_ENABLED accepts true, 1 or yes (the one exception to the on/off rule)
# CDN_TOKEN_AUTH_ENABLED=false
# CDN_TOKEN_AUTH_KEY=your-cdn-signing-key
# CDN_TOKEN_AUTH_PARAM=auth_key
# CDN_TOKEN_AUTH_ALGORITHM=sha256
# Comma/semicolon-separated folder prefixes that require CDN token auth (e.g. "videos/,shorts/")
# CDN_TOKEN_PROTECTED_PREFIXES=
# Comma/semicolon-separated file extensions that require CDN token auth (defaults: .mp4,.m3u8,.ts,.m4s,.key)
# CDN_TOKEN_PROTECTED_EXTENSIONS=
# Comma/semicolon-separated folder prefixes served as plain public CDN URLs (no signing)
# CDN_UNSIGNED_PUBLIC_PREFIXES=

# CORS Configuration
# Comma-separated list of allowed web origins. Mobile apps (no Origin header) are always allowed.
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"

# Redis Configuration
# Optional. Leave REDIS_HOST (and REDIS_HOSTS) empty to run without Redis: an
# in-memory store is used instead — fine for one instance, but rate limits and
# caches are then per process, so use Redis when running several replicas.
# Single node: set REDIS_HOST / REDIS_PORT / REDIS_DB
# Cluster mode: set REDIS_HOSTS as comma-separated host:port pairs (e.g. "node1:6379,node2:6379")
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# REDIS_HOSTS=node1:6379,node2:6379

# Rate Limiting
# Global default: 200 requests per 60 seconds per IP.
# DISABLE_RATE_LIMIT (on/off): true switches rate limiting off (local dev only)
DISABLE_RATE_LIMIT=false

# Firebase Push Notifications (optional — only needed if using PushNotificationModule)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Cron
# Run scheduled jobs (src/core/cron) on this instance — set true on exactly one replica.
# EXECUTE_CRON (on/off)
EXECUTE_CRON=false

# Pokemon OCR
# Python FastAPI OCR service (Pokemon-OCR repo)
OCR_SERVICE_URL=http://localhost:8000
# DEV ONLY: let /collection routes accept `x-user-id: <uuid>` instead of a JWT,
# for the Flutter app until it has a login screen. Ignored when NODE_ENV=production.
DEV_USER_HEADER_AUTH=false
